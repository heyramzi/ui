{
  "name": "@heyramzi/tasks",
  "version": "0.3.0",
  "description": "Svelte 5 task views: a drag-and-drop board, a grouped list and a gantt timeline from one config, plus status badges, dots and icons.",
  "keywords": [
    "svelte",
    "svelte5",
    "kanban",
    "board",
    "gantt",
    "timeline",
    "tasks",
    "drag-and-drop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyramzi/ui.git",
    "directory": "packages/tasks"
  },
  "homepage": "https://ui.heyramzi.com/tasks",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./kanban": {
      "svelte": "./src/kanban-board.svelte",
      "types": "./src/kanban-board.svelte",
      "default": "./src/kanban-board.svelte"
    },
    "./list": {
      "svelte": "./src/task-list.svelte",
      "types": "./src/task-list.svelte",
      "default": "./src/task-list.svelte"
    },
    "./gantt": {
      "svelte": "./src/task-gantt.svelte",
      "types": "./src/task-gantt.svelte",
      "default": "./src/task-gantt.svelte"
    },
    "./status": {
      "svelte": "./src/status-badge.svelte",
      "types": "./src/status-badge.svelte",
      "default": "./src/status-badge.svelte"
    },
    "./presets/sales": {
      "svelte": "./src/presets/sales.ts",
      "types": "./src/presets/sales.ts",
      "default": "./src/presets/sales.ts"
    },
    "./demo": {
      "svelte": "./src/demo.svelte",
      "default": "./src/demo.svelte"
    },
    "./demo.svelte": "./src/demo.svelte"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2"
  }
}
