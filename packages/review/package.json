{
  "name": "@heyramzi/review",
  "version": "1.1.1",
  "description": "The one review UI for Editor OS, Shorts OS and any client tool. A Svelte 5 page built to two static files, plus the Node handler that serves it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyramzi/ui.git",
    "directory": "packages/review"
  },
  "files": [
    "dist",
    "src/theme",
    "package.json"
  ],
  "type": "module",
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#src/*.svelte": "./src/*.svelte",
    "#src/*.css": "./src/*.css",
    "#src/*.svg": "./src/*.svg",
    "#dev/*.js": "./dev/*.ts",
    "#scripts/*": "./scripts/*"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/review.js"
    },
    "./review.css": "./dist/review.css",
    "./tokens.css": "./src/theme/tokens.css",
    "./server": {
      "types": "./dist/node/server/index.d.ts",
      "default": "./dist/node/server/index.js"
    },
    "./types": {
      "types": "./dist/node/core/types.d.ts",
      "default": "./dist/node/core/types.js"
    },
    "./figure": {
      "types": "./dist/node/diagrams/figure.d.ts",
      "default": "./dist/node/diagrams/figure.js"
    },
    "./placeholder": {
      "types": "./dist/node/diagrams/placeholder.d.ts",
      "default": "./dist/node/diagrams/placeholder.js"
    }
  },
  "scripts": {
    "dev": "vp dev --port 3321 --strictPort",
    "build": "vp build",
    "prepack": "vp build && node scripts/build-publish.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vp test run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@heyramzi/ui": "workspace:*",
    "@heyramzi/utils": "^1.12.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~7.0.2",
    "vite-plus": "catalog:"
  }
}
