{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3101",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@heyramzi/marketing": "workspace:*",
    "@heyramzi/review": "workspace:*",
    "@heyramzi/ui": "workspace:*",
    "phosphor-svelte": "^3.1.1"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#src/*": "./src/*"
  }
