{
  "name": "@heyramzi/rich-editor",
  "version": "1.0.2",
  "description": "Svelte 5 rich text editor on Tiptap: slash menu, image toolbar, block ids, a Markdown bridge and an SSR renderer for the saved JSON.",
  "keywords": [
    "svelte",
    "svelte5",
    "tiptap",
    "editor",
    "rich-text",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyramzi/ui.git",
    "directory": "packages/rich-editor"
  },
  "homepage": "https://ui.heyramzi.com",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./serializer": {
      "types": "./src/serializer.ts",
      "default": "./src/serializer.ts"
    },
    "./markdown": {
      "types": "./src/markdown.ts",
      "default": "./src/markdown.ts"
    },
    "./block-ops": {
      "types": "./src/block-ops.ts",
      "default": "./src/block-ops.ts"
    },
    "./inline-editor": {
      "svelte": "./src/inline-editor.svelte",
      "default": "./src/inline-editor.svelte"
    },
    "./content.css": {
      "style": "./src/content.css",
      "default": "./src/content.css"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-drag-handle": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "markdown-it": "^15.0.2",
    "phosphor-svelte": "^3.1.0"
  },
  "devDependencies": {
    "@heyramzi/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "vite-plus": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@heyramzi/ui": ">=1.52.0",
    "svelte": "^5.57.2"
  }
}
