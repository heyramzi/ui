#!/usr/bin/env sh
# >>> push scope (managed) >>>
# What this push changes against the upstream. Every guard below judges only these files.
__push_tip=""
if [ "${PUSH_FILES+x}" != x ]; then
  __push_lines=$(cat)
  # Each pushed tip is judged on its own, so a push of two refs runs this hook once per tip.
  __push_tips=$(printf '%s\n' "$__push_lines" | awk 'NF == 4 && $2 ~ /[^0]/ { print $2 }' | sort -u)
  if [ "$(printf '%s\n' "$__push_tips" | grep -c .)" -gt 1 ]; then
    __push_e=""
    case $- in *e*) __push_e=-e ;; esac
    for __push_one in $__push_tips; do
      echo "push scope: judging $(git rev-parse --short "$__push_one")"
      printf '%s\n' "$__push_lines" | awk -v t="$__push_one" '$2 == t' | sh $__push_e "$0" "$@" || exit 1
    done
    exit 0
  fi
  PUSH_FILES=""
  __push_refs=0
  while read -r __local_ref __local_sha __remote_ref __remote_sha; do
    [ -n "$__local_ref" ] || continue
    __push_refs=1
    case "$__local_sha" in *[!0]*) ;; *) continue ;; esac
    __push_tip="$__local_sha"
    case "$__remote_sha" in
      *[!0]*) __push_base="$__remote_sha" ;;
      *) __push_base=$(git merge-base "$__local_sha" '@{u}' 2>/dev/null || git merge-base "$__local_sha" origin/HEAD 2>/dev/null || true) ;;
    esac
    if [ -n "$__push_base" ]; then
      __push_files=$(git diff --name-status -M --diff-filter=ACMR "$__push_base" "$__local_sha" | awk -F'\t' '$1 != "R100" { print $NF }') || exit 1
    else
      __push_files=$(git ls-tree -r --name-only "$__local_sha") || exit 1
    fi
    PUSH_FILES="${PUSH_FILES}${PUSH_FILES:+
}${__push_files}"
  done <<__PUSH_REFS
$__push_lines
__PUSH_REFS
  if [ "$__push_refs" -eq 0 ]; then
    __push_tip=$(git rev-parse --verify --quiet HEAD || true)
    __push_base=$(git merge-base HEAD '@{u}' 2>/dev/null || git merge-base HEAD origin/HEAD 2>/dev/null || true)
    if [ -n "$__push_base" ]; then
      PUSH_FILES=$(git diff --name-status -M --diff-filter=ACMR "$__push_base" HEAD | awk -F'\t' '$1 != "R100" { print $NF }') || exit 1
    else
      PUSH_FILES=$(git ls-files) || exit 1
    fi
  fi
  # A pure move (R100) changes nothing. Projections and the Editor OS plugin build are generated and judged at their source.
  PUSH_FILES=$(printf '%s\n' "$PUSH_FILES" | grep -vE '^\.(agents|claude|opencode|gemini)/|^\.github/skills/|^plugins/editor-os/(agents|bin|descript|edit|motion|skills|studio)/' || true)
fi
# Gates read from disk, so a working tree that differs from the pushed tip (another session's half-edit)
# sends them to a temporary worktree of the tip.
if [ -n "$__push_tip" ] && [ -n "$PUSH_FILES" ] && [ "${HUSKY-}" != "0" ] && [ "${VITE_GIT_HOOKS-}" != "0" ]; then
  __push_stale=0
  [ "$(git rev-parse --verify --quiet HEAD || true)" = "$__push_tip" ] || __push_stale=1
  # The whole tree, not only PUSH_FILES: Fallow reads every file, so a half-edit elsewhere failed the push.
  if [ "$__push_stale" = 0 ]; then
    git diff --quiet "$__push_tip" -- >/dev/null 2>&1 || __push_stale=1
    [ -z "$(git ls-files --others --exclude-standard | head -n 1)" ] || __push_stale=1
  fi
  if [ "$__push_stale" = 0 ]; then
    echo "push scope: working tree matches $(git rev-parse --short "$__push_tip"), gates read it in place"
  else
    __push_real=$(git rev-parse --show-toplevel)
    # Built by hand, not `git worktree add`, so .git/worktrees stays empty: Orca listed each push's checkout as a
    # detached HEAD (29 Oct 2026).
    __push_common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1
    # Beside the repo, not in $TMPDIR: a skill symlinked to a sibling repo, and Studio itself, resolve from there.
    # One kept checkout per repo, moved to each tip, rewrites only what changed: a fresh one wrote upsys's 31,000
    # files in 47 s (TSK-2975). A push that finds it busy takes a temporary one.
    __push_repo=$__push_real
    case "$__push_common" in */.git) __push_repo=$(dirname "$__push_common") ;; esac
    __push_wt="$(dirname "$__push_repo")/.push-gate-$(basename "$__push_repo")"
    __push_admin="$__push_common/temp-checkouts/$(basename "$__push_wt")"
    __push_keep=0
    # Only the main checkout keeps one: each git-sync worktree left its own 2.8 GB, 34 GB in a day (TSK-3000).
    if [ "${PUSH_GATE_FRESH-}" != 1 ] && [ "$__push_real" = "$__push_repo" ]; then
      if [ -f "$__push_wt.lock/pid" ] && ! kill -0 "$(cat "$__push_wt.lock/pid")" 2>/dev/null; then
        # A push killed mid-move leaves its lock and a half-moved checkout, so both go.
        rm -rf "$__push_wt.lock" "$__push_wt" "$__push_admin"
      fi
      if mkdir "$__push_wt.lock" 2>/dev/null; then
        printf '%s\n' $$ > "$__push_wt.lock/pid"
        __push_keep=1
        # Its node_modules are links into the real install, so a changed lockfile rebuilds it.
        __push_deps=$(cat "$__push_real/pnpm-lock.yaml" "$__push_real/bun.lock" 2>/dev/null | cksum)
        [ "$(cat "$__push_admin/deps" 2>/dev/null)" = "$__push_deps" ] || rm -rf "$__push_wt" "$__push_admin"
      fi
    fi
    if [ "$__push_keep" = 1 ]; then
      mkdir -p "$__push_wt"
      __push_links=/dev/null
      trap 'cd "$__push_real" 2>/dev/null; rm -f "$__push_wt.nm" "$__push_wt.kit"; rm -rf "$__push_wt.lock"' EXIT
    else
      __push_wt=$(mktemp -d "$(dirname "$__push_repo")/.push-gate-$(basename "$__push_repo").XXXXXX")
      __push_admin="$__push_common/temp-checkouts/$(basename "$__push_wt")"
      __push_links="$__push_wt.links"
      : > "$__push_links"
      # The links go first, so a recursive delete never reaches the real node_modules. The tree goes in the background:
      # upsys's 4.5 GB took 3 to 8 s (TSK-2955).
      trap 'cd "$__push_real" 2>/dev/null; while IFS= read -r __l; do rm -f "$__l"; done < "$__push_links"; rm -rf "$__push_admin"; rm -f "$__push_links" "$__push_wt.nm" "$__push_wt.kit"; ( rm -rf "$__push_wt" ) </dev/null >/dev/null 2>&1 &' EXIT
    fi
    trap 'exit 130' INT TERM HUP
    mkdir -p "$__push_admin/info" || exit 1
    printf '%s\n' "$__push_common" > "$__push_admin/commondir"
    __push_prev=$(cat "$__push_admin/HEAD" 2>/dev/null || true)
    printf '%s\n' "$__push_tip" > "$__push_admin/HEAD"
    printf 'gitdir: %s\n' "$__push_admin" > "$__push_wt/.git"
    # No gate reads video or audio, and upsys holds 1.7 GB of it; full-gate.yml leaves out the same list.
    printf '%s\n' '/*' '!*.mov' '!*.mp4' '!*.webm' '!*.wav' '!*.mp3' '!*.m4a' > "$__push_admin/info/sparse-checkout"
    # A worktree lacks node_modules, generated output and the gitignored .impeccable config: fallow called imports unresolved, the design gate flagged brand fonts (TSK-2432).
    # Found in the real tree, during the checkout.
    __push_scan() {
      ( cd "$__push_real" && find . \( -name .git -o -name node_modules -o -name paraglide -o -name .svelte-kit -o -name .wxt -o -name .impeccable \) -prune ! -name .git -print 2>/dev/null || true )
    }
    __push_find=""
    if [ "$__push_keep" = 1 ] && [ -f "$__push_admin/nm" ]; then
      # The scan took 4.9 s in upsys and its list moves only when an app or an install appears, so the kept
      # checkout reads the last push's list and rescans after this one.
      cp "$__push_admin/nm" "$__push_wt.nm"
      ( __push_scan > "$__push_admin/nm.new" && mv "$__push_admin/nm.new" "$__push_admin/nm" ) </dev/null >/dev/null 2>&1 &
    else
      __push_scan > "$__push_wt.nm" &
      __push_find=$!
    fi
    # The explicit dirs and the unset index keep an inherited GIT_DIR or GIT_INDEX_FILE off the real checkout.
    # A worker per core: upsys took 40 s with one, 13 s with 12.
    __push_git() {
      env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git --git-dir="$__push_admin" --work-tree="$__push_wt" \
        -c core.hooksPath=/dev/null -c checkout.workers=0 -c core.sparseCheckout=true "$@"
    }
    # read-tree skips a file whose index entry didn't move, so one a gate left edited is restored too.
    if ! { __push_git read-tree --reset -u HEAD && __push_git diff-files --name-only -z | __push_git checkout-index -f -z --stdin; }; then
      [ -z "$__push_find" ] || wait "$__push_find"
      [ "$__push_keep" = 1 ] && rm -rf "$__push_wt" "$__push_admin"
      exit 1
    fi
    [ "$__push_keep" = 1 ] && printf '%s\n' "$__push_deps" > "$__push_admin/deps"
    if [ -n "$__push_find" ]; then
      wait "$__push_find"
      [ "$__push_keep" = 1 ] && cp "$__push_wt.nm" "$__push_admin/nm"
    fi
    # Every file the kept checkout moved across, this push's or another session's: an app none of them touched keeps its types.
    __push_moved=""
    [ "$__push_keep" = 1 ] && [ -n "$__push_prev" ] && __push_moved=$(__push_git diff --name-only "$__push_prev" "$__push_tip" 2>/dev/null || echo "*")
    : > "$__push_wt.kit"
    while IFS= read -r __push_nm; do
      __push_nm=${__push_nm#./}
      if [ ! -d "$__push_wt/$(dirname "$__push_nm")" ]; then
        :
      elif [ "$(basename "$__push_nm")" = .svelte-kit ]; then
        # A linked .svelte-kit typed the real checkout's untracked routes: 27 errors refused an immo push (16 Nov 2026).
        # Synced on every push, kept checkout or not, so a new route gets its types.
        dirname "$__push_nm" >> "$__push_wt.kit"
      elif [ -e "$__push_wt/$__push_nm" ]; then
        :
      elif [ -d "$__push_real/$__push_nm/\$app" ]; then
        # Kit's $app/tsconfig.json holds relative paths, so it's copied: through a link it resolved outside the worktree and fallow dropped @ext.
        mkdir "$__push_wt/$__push_nm" || exit 1
        for __push_e in "$__push_real/$__push_nm"/* "$__push_real/$__push_nm"/.[!.]*; do
          [ -e "$__push_e" ] || [ -L "$__push_e" ] || continue
          [ "$(basename "$__push_e")" = "\$app" ] && continue
          ln -s "$__push_e" "$__push_wt/$__push_nm/" && printf '%s\n' "$__push_wt/$__push_nm/$(basename "$__push_e")" >> "$__push_links"
        done
        cp -R "$__push_real/$__push_nm/\$app" "$__push_wt/$__push_nm/"
      else
        ln -s "$__push_real/$__push_nm" "$__push_wt/$__push_nm" && printf '%s\n' "$__push_wt/$__push_nm" >> "$__push_links"
      fi
    done < "$__push_wt.nm"
    rm -f "$__push_wt.nm"
    # After the node_modules links, so each app's own svelte-kit generates its types from the tip. The apps sync side by side.
    __push_syncs=""
    while IFS= read -r __push_app; do
      if [ -n "$__push_prev" ] && [ "$__push_keep" = 1 ] && [ -d "$__push_wt/$__push_app/.svelte-kit" ] && [ "$__push_moved" != "*" ]; then
        case "$__push_app" in
          .) [ -n "$__push_moved" ] || continue ;;
          *) printf '%s\n' "$__push_moved" | grep -q "^$__push_app/" || continue ;;
        esac
      fi
      __push_d="$__push_wt/$__push_app"
      until [ -x "$__push_d/node_modules/.bin/svelte-kit" ] || [ "$__push_d" = "$__push_wt" ]; do
        __push_d=$(dirname "$__push_d")
      done
      if [ -x "$__push_d/node_modules/.bin/svelte-kit" ]; then
        { ( cd "$__push_wt/$__push_app" && "$__push_d/node_modules/.bin/svelte-kit" sync >/dev/null 2>&1 ) ||
          echo "push scope: svelte-kit sync failed in $__push_app, so its gates read no generated types"; } &
        __push_syncs="$__push_syncs $!"
      fi
    done < "$__push_wt.kit"
    for __push_s in $__push_syncs; do wait "$__push_s"; done
    rm -f "$__push_wt.kit"
    __push_kind="a temporary checkout"
    [ "$__push_keep" = 1 ] && __push_kind="the kept checkout $__push_wt"
    echo "push scope: working tree differs from $(git rev-parse --short "$__push_tip"), gates read $__push_kind of it"
    cd "$__push_wt"
    # pnpm's install before a script wrote through the links and repointed the real .bin shims at this worktree.
    export pnpm_config_verify_deps_before_run=false
  fi
  # A detached HEAD, like git-sync-main's replay checkout, has no upstream: push-diff fell back to origin/HEAD.
  if [ -z "${PUSH_BASE-}" ] && [ -n "${__push_base-}" ]; then export PUSH_BASE="$__push_base"; fi
fi
export PUSH_FILES
__push_code=$(printf '%s\n' "$PUSH_FILES" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|svelte)$' || true)
# <<< push scope (managed) <<<

# >>> gate runner (managed) >>>
# `__gate_bg <name> <function>` starts a gate as a background job with its own log. `__gate_wait` prints
# the logs in start order and fails naming every gate that failed. The repo's own lines can use both.
__gate_list=""
__gate_dir=""
__gate_bg() {
  [ -n "$__gate_dir" ] || __gate_dir=$(mktemp -d "${TMPDIR:-/tmp}/push-gates.XXXXXX") || exit 1
  (
    __gate_t=$(date +%s)
    if ( "$2" ); then __gate_rc=0; else __gate_rc=$?; fi
    echo "$(($(date +%s) - __gate_t))" > "$__gate_dir/$1.s"
    exit "$__gate_rc"
  ) > "$__gate_dir/$1" 2>&1 &
  __gate_list="$__gate_list $1:$!"
}
__gate_wait() {
  __gate_failed=""
  for __gate in $__gate_list; do
    if wait "${__gate##*:}"; then __gate_rc=0; else __gate_rc=$?; fi
    __gate=${__gate%:*}
    cat "$__gate_dir/$__gate"
    __gate_s=$(cat "$__gate_dir/$__gate.s" 2>/dev/null || echo "?")
    if [ "$__gate_rc" -eq 0 ]; then
      echo "-- $__gate: ok in ${__gate_s}s"
    else
      echo "-- $__gate: FAILED (exit $__gate_rc) in ${__gate_s}s"
      __gate_failed="$__gate_failed $__gate"
    fi
  done
  [ -z "$__gate_dir" ] || rm -rf "$__gate_dir"
  __gate_dir=""
  __gate_list=""
  [ -z "$__gate_failed" ] || { echo "push gate: failed:$__gate_failed"; return 1; }
}
# A background job ignores Ctrl-C, so the interrupt kills each gate and its children before the scope's cleanup runs.
__gate_kill() {
  for __gate_p in "$@"; do
    __gate_kids=$(pgrep -P "$__gate_p" 2>/dev/null)
    kill "$__gate_p" 2>/dev/null
    [ -z "$__gate_kids" ] || __gate_kill $__gate_kids
  done
}
trap 'for __gate in $__gate_list; do __gate_kill "${__gate##*:}"; done; [ -z "$__gate_dir" ] || rm -rf "$__gate_dir"; exit 130' INT TERM HUP
# <<< gate runner (managed) <<<

# >>> repo pre-push (managed) >>>
# This repo's own checks, in its tracked scripts/hooks/pre-push.
__gate_repo() {
  sh scripts/hooks/pre-push </dev/null || exit 1
}
__gate_bg repo __gate_repo
# <<< repo pre-push (managed) <<<

# >>> comment-length pre-push guard (managed) >>>
# The 30-word comment cap, packages/lint/README.md in vibe-kit. Installed by
# vibe-kit/ai-doc/scripts/pre-push-hooks.sh; edit there, not here.
__gate_comment_length() {
if [ "${HUSKY-}" != "0" ] && [ "${VITE_GIT_HOOKS-}" != "0" ]; then
  __cl_root=$(git rev-parse --show-toplevel)
  __cl_bin="$HOME/Studio/upsys/kit/packages/lint/bin/heyramzi-comment-length.js"
  [ -f "$__cl_bin" ] || __cl_bin="$__cl_root/node_modules/@heyramzi/lint/bin/heyramzi-comment-length.js"
  if [ -z "${__push_code-}" ]; then
    echo "comment-length: skip (no code in this push)"
  elif [ -f "$__cl_bin" ]; then
    echo "comment-length: checking ..."
    ( cd "$__cl_root" && node "$__cl_bin" ) || exit 1
  else
    echo "comment-length: skip (@heyramzi/lint not installed)"
  fi
fi
}
__gate_bg comment-length __gate_comment_length
# <<< comment-length pre-push guard (managed) <<<

# >>> code gate pre-push guard (managed) >>>
# Format and lint only the pushed files. Whole-project checks run in CI.
# vibe-kit svelte-standards/references/lint.md. Installed by pre-push-hooks.sh.
__gate_code() {
if [ "${HUSKY-}" != "0" ] && [ "${VITE_GIT_HOOKS-}" != "0" ]; then
  __cg_root=$(git rev-parse --show-toplevel)
  if [ -z "${__push_code-}" ]; then
    echo "code gate: skip (no code in this push)"
  else
    __cg_n=$(printf '%s\n' "$__push_code" | wc -l | tr -d ' ')
    if [ -x "$__cg_root/node_modules/.bin/vp" ]; then
      echo "code gate: format and lint $__cg_n pushed files ..."
      __cg_cfg=""
      [ -f "$__cg_root/.oxlintrc.json" ] && __cg_cfg="-c .oxlintrc.json"
      ( cd "$__cg_root" && printf '%s\n' "$__push_code" | while IFS= read -r f; do [ -f "$f" ] && printf '%s\0' "$f"; done \
        | xargs -0 node_modules/.bin/vp fmt --check --no-error-on-unmatched-pattern ) || exit 1
      ( cd "$__cg_root" && printf '%s\n' "$__push_code" | while IFS= read -r f; do [ -f "$f" ] && printf '%s\0' "$f"; done \
        | xargs -0 node_modules/.bin/vp lint --quiet --no-error-on-unmatched-pattern $__cg_cfg ) || exit 1
    else
      echo "code gate: skip (Vite+ not installed)"
    fi
  fi
fi
}
__gate_bg code __gate_code
# <<< code gate pre-push guard (managed) <<<

# >>> slop pre-push guard (managed) >>>
# The slop check over this repo's copy. Installed by
# vibe-kit/ai-doc/scripts/pre-push-hooks.sh; edit there, not here.
__gate_slop() {
if [ "${HUSKY-}" != "0" ] && [ "${VITE_GIT_HOOKS-}" != "0" ]; then
  __sl_check="$HOME/Studio/upsys/kit/ai-doc/scripts/slop-check.mjs"
  if [ -f "$__sl_check" ]; then
    echo "slop: checking ..."
    ( cd "$(git rev-parse --show-toplevel)" && __sl_files=$(node "$__sl_check" --list) && printf '%s\n' "$__sl_files" | node -e '
      const { spawnSync } = require("node:child_process");
      const { existsSync } = require("node:fs");
      const pushed = new Set(process.env.PUSH_FILES.split("\n"));
      let input = "";
      process.stdin.on("data", d => input += d).on("end", () => {
        const files = input.split("\n").filter(f => pushed.has(f) && existsSync(f));
        if (!files.length) return;
        const status = spawnSync("node", [process.argv[1], ...files], { stdio: "inherit" }).status ?? 1;
        if (status !== 0) spawnSync("node", [process.argv[2], "--hint", ...files], { stdio: "inherit" });
        process.exit(status);
      });' "$HOME/Studio/upsys/kit/packages/lint/bin/heyramzi-slop.js" "$__sl_check" ) || exit 1
    # Instruction files aren't copy, so they get the one check every file passes: no dashes.
    # Vendored text is replaced whole on its next upgrade, so it's skipped.
    __sl_docs=$(printf '%s\n' "$PUSH_FILES" | grep -E '^ai-doc/.*\.md$|(^|/)(AGENTS|CLAUDE|GEMINI|CODING_STANDARDS)\.md$' \
      | grep -vE '^ai-doc/references/demandcurve/|^ai-doc/skills/content/video/tesseract-video/|^ai-doc/skills/engineering/security/security-audit/|/motion-design/references/remotion/|/anti-ai-slop/references/color-expert\.md$|^ai-doc/skills/apple/release/app-store-screenshots/' || true)
    if [ -n "$__sl_docs" ]; then
      echo "slop: instruction files, dashes ..."
      ( cd "$(git rev-parse --show-toplevel)" && printf '%s\n' "$__sl_docs" | while IFS= read -r f; do [ -f "$f" ] && printf '%s\0' "$f"; done \
        | xargs -0 sh -c 'if [ $# -gt 0 ]; then exec node "$0" --only=dash "$@"; fi' "$HOME/Studio/upsys/kit/packages/lint/bin/heyramzi-slop.js" ) || exit 1
    fi
  else
    echo "slop: skip (no vibe-kit checkout)"
  fi
fi
}
__gate_bg slop __gate_slop
# <<< slop pre-push guard (managed) <<<

# >>> design pre-push guard (managed) >>>
# Impeccable detector over pushed UI files. Installed by
# vibe-kit/ai-doc/scripts/pre-push-hooks.sh; edit there, not here.
__gate_design() {
if [ "${HUSKY-}" != "0" ] && [ "${VITE_GIT_HOOKS-}" != "0" ]; then
  __design_root=$(git rev-parse --show-toplevel)
  __design_bin="$__design_root/.claude/skills/impeccable/scripts/impeccable"
  [ -x "$__design_bin" ] || __design_bin="$__design_root/.agents/skills/impeccable/scripts/impeccable"
  [ -x "$__design_bin" ] || __design_bin="$HOME/.agents/skills/impeccable/scripts/impeccable"
  # A sync replaces .upstream/ copies whole, so their upstream style isn't ours to judge.
  # upsys's kit/ isn't held to upsys's DESIGN.md: its fmt and lint skip kit/** for the same reason.
  __design_files=$(printf '%s\n' "$PUSH_FILES" | grep -E '\.(tsx|jsx|html|vue|svelte|astro|css|scss|sass|less|ts|js)$' | grep -v '^kit/' | grep -v '/skills/impeccable/' | grep -v 'node_modules/' | grep -vE '(^|/)playground/' | grep -v '/\.upstream/' | grep -v '/inputs/' | grep -vE '(^|/)(emails?|[a-z-]*email-templates|resend-templates)/|(^|/)emails?\.(ts|js)$|(^|/)[a-z0-9-]*-email\.html$' || true)
  if [ -z "$__design_files" ]; then
    echo "design: skip (no UI files in this push)"
  elif [ ! -x "$__design_bin" ]; then
    echo "design: skip (impeccable not installed)"
  else
    echo "design: checking ..."
    ( cd "$__design_root" && printf '%s\n' "$__design_files" | while IFS= read -r f; do [ -f "$f" ] && printf '%s\0' "$f"; done \
      | xargs -0 sh -c 'if [ $# -gt 0 ]; then exec "$0" detect "$@"; fi' "$__design_bin" ) || exit 1
  fi
fi
}
__gate_bg design __gate_design
# <<< design pre-push guard (managed) <<<

