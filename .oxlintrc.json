{
  "extends": ["./node_modules/@heyramzi/lint/config/oxlintrc.json"],
  "jsPlugins": ["@heyramzi/lint"],
  "ignorePatterns": [
    "**/.agents/**",
    "**/.claude/**",
    "**/.opencode/**",
    "**/_generated/**",
    "**/vendor/**",
    "**/.upstream/**",
    "**/*.generated.*",
    "**/public/**",
    "**/node_modules/**",
    "**/dist/**",
    "build/**",
    "**/.svelte-kit/**",
    "**/.next/**",
    "**/.output/**",
    "**/.vercel/**",
    "**/.wrangler/**",
    "**/coverage/**",
    "**/scripts/secrets.mjs",
    "**/scripts/secrets-auto.mjs",
    "**/scripts/secrets.d.mts",
    "packages/ui/.upstream/**",
    "packages/ui/src/shadcn/**",
    "packages/ui/src/agents/vendor/**",
    "site/src/lib/shadcn-demos/**"
  ],
  "overrides": [
    {
      "files": [
        "**/packages/ui/src/charts/ring-chart.svelte",
        "**/packages/ui/src/charts/gauge-chart.svelte",
        "**/packages/ui/src/status/status-dot.svelte",
        "**/packages/ui/src/work/time/time-ring.svelte",
        "**/packages/ui/src/work/gantt/gantt-grid.svelte"
      ],
      "rules": {
        "@heyramzi/lint/no-inline-svg": "off"
      }
    },
    {
      "files": [
        "**/packages/ui/src/effects/spotlight/Spotlight.svelte",
        "**/packages/ui/src/effects/image-comparison/ImageComparison.svelte",
        "**/packages/ui/src/slides/Controls.svelte",
        "**/packages/ui/src/slides/demo-slides.svelte",
        "**/packages/review/src/ui/LibrarySearch.svelte"
      ],
      "rules": {
        "@heyramzi/lint/no-inline-svg": "off"
      }
    },
    {
      "files": ["**/packages/ui/src/slides/model.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
