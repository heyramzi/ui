    else
      echo "$__pc_gate: skip (@heyramzi/lint not installed)"
    fi
  done
  __pc_swift="$HOME/Studio/upsys/kit/swift/lint/house-lint.mjs"
  if [ -f "$__pc_swift" ] && git diff --cached --name-only --diff-filter=ACMR | grep -q '\.swift$'; then
    ( cd "$__pc_root" && node "$__pc_swift" ) || exit 1
  fi
