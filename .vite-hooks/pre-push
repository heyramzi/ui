# <<< inline-path pre-push guard (managed) <<<

# >>> push gates (managed) >>>
# UI, Svelte markup, pushed-diff, old-name and repo convention gates over PUSH_FILES. Installed by
# vibe-kit/ai-doc/scripts/pre-push-hooks.sh; edit there, not here.
__gate_push_gates() {
if [ "${HUSKY-}" != "0" ] && [ "${VITE_GIT_HOOKS-}" != "0" ]; then
  __pg_root=$(git rev-parse --show-toplevel)
  __pg_lint="$HOME/Studio/upsys/kit/packages/lint/bin"
  [ -d "$__pg_lint" ] || __pg_lint="$__pg_root/node_modules/@heyramzi/lint/bin"
  for __pg_gate in ui-rules svelte-markup push-diff old-names; do
    [ -f "$__pg_lint/heyramzi-$__pg_gate.js" ] || continue
    ( cd "$__pg_root" && node "$__pg_lint/heyramzi-$__pg_gate.js" ) || exit 1
  done
  for __pg_check in check-conventions check-no-core; do
    [ -f "$__pg_root/scripts/$__pg_check.mjs" ] || continue
    ( cd "$__pg_root" && node "scripts/$__pg_check.mjs" ) || exit 1
  done
  # Only repos a stranger or a buyer reads: ai-agency is public, agency-os ships to buyers.
  case "$(basename "$__pg_root")" in
    ai-agency | agency-os)
      ( cd "$__pg_root" && node "$HOME/Studio/upsys/kit/ai-doc/scripts/check-public-hygiene.mjs" ) || exit 1 ;;
  esac
fi
}
__gate_bg push-gates __gate_push_gates
# <<< push gates (managed) <<<

# >>> gate results (managed) >>>
__gate_wait || exit 1
# <<< gate results (managed) <<<

# >>> flows publish (managed) >>>
# A push that passed its gates and touches an app with a flows.json republishes that app's
# user flows to the portfolio in the background (kit/scripts/flows.mjs, TSK-2968).
if [ "${FLOWS_PUBLISH-}" != "0" ] && [ -f "$HOME/Studio/upsys/kit/scripts/flows.mjs" ]; then
  # git-sync-main.sh pushes from a temp worktree with no node_modules, so publish from the main checkout.
  __fl_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  for __fl_json in $(git -C "$__fl_root" ls-files 'flows.json' '*/flows.json'); do
    __fl_dir=$(dirname "$__fl_json")
    [ "$__fl_dir" = "." ] && __fl_match='' || __fl_match="$__fl_dir/"
    printf '%s\n' "$PUSH_FILES" | grep -qE "^${__fl_match}.*\.(svelte|ts|css|swift|xcstrings|json)$" || continue
    mkdir -p "$__fl_root/$__fl_dir/build/flows"
    nohup node "$HOME/Studio/upsys/kit/scripts/flows.mjs" publish "$__fl_root/$__fl_dir" --capture \
      > "$__fl_root/$__fl_dir/build/flows/publish.log" 2>&1 </dev/null &
    echo "flows: republishing $__fl_dir in the background ($__fl_dir/build/flows/publish.log)"
  done
fi
# <<< flows publish (managed) <<<
