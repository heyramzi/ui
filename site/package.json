{
  "name": "site",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3101",
    "build": "vp build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vp test run",
    "deploy": "vp build && wrangler deploy",
    "test:gallery": "vp build && playwright test",
    "test:gallery:record-axe": "vp build && GALLERY_AXE=record playwright test"
  },
  "dependencies": {
    "@heyramzi/ui": "workspace:*",
    "@xyflow/svelte": "^1.7.1",
    "phosphor-svelte": "^3.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@heyramzi/utils": "^1.20.0",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "wrangler": "^4.157.0"
  }
}
