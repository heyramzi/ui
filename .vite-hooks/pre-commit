# WHY: `vp staged` (lint-staged) `git add`s every file whose working-tree diff changed while its
# tasks ran, so another session's edit landing mid-format joined `git commit --only` (2 commits,
# 10 Nov 2026). This wraps the repo's own `vp staged` line and fails the commit, naming the paths.
vp() {
  [ "${1-}" = "staged" ] || { command vp "$@"; return; }
  __pc_before=$(mktemp)
  git diff --cached --name-only > "$__pc_before"
  command vp "$@" || { __pc_rc=$?; rm -f "$__pc_before"; return "$__pc_rc"; }
  __pc_extra=$(git diff --cached --name-only | grep -vxF -f "$__pc_before" || true)
  rm -f "$__pc_before"
  [ -z "$__pc_extra" ] && return 0
  echo "pre-commit: vp staged added files this commit was never given (another session edited them mid-run):" >&2
  printf '%s\n' "$__pc_extra" | sed 's/^/  /' >&2
  echo "pre-commit: commit refused, nothing committed or staged; run the same commit again." >&2
  return 1
}
