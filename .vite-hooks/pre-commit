if [ "${HUSKY-}" != "0" ] && [ "${VITE_GIT_HOOKS-}" != "0" ]; then
  __pc_root=$(git rev-parse --show-toplevel)
  __pc_lint="$HOME/Studio/upsys/kit/packages/lint/bin"
  [ -d "$__pc_lint" ] || __pc_lint="$__pc_root/node_modules/@heyramzi/lint/bin"
  for __pc_gate in file-tokens repo-rules; do
